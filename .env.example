# API settings for LOCAL development only. Copy to .env (git-ignored).
# Real values live in Vercel; never commit secrets. The repo is public.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
APP_BASE_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=transfunnel.com
TEST_SIGNIN=on
# WorkOS (only needed to test real sign-in locally; use Staging keys)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
