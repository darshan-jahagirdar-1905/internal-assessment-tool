# Edge Function secrets for LOCAL `supabase functions serve --env-file`.
# Copy to supabase/functions/.env (git-ignored). Hosted values are set by a
# person in Supabase > Edge Functions > Secrets, never in the repo.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
ADMIN_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM="HR Team <assessments@hr.yourcompany.com>"
APP_BASE_URL=http://localhost:5173
